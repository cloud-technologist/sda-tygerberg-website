# Copy to `.dev.vars` (gitignored) to exercise the LIVE badge under
# `npm run worker:dev`. In production these two are Worker *secrets*, set in
# the Cloudflare dashboard under Workers & Pages -> tygerberg-sda-website ->
# Settings -> Variables and Secrets. They must never be build-time/Actions
# variables — that would bake the API key into the public JS bundle.
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=UCtZlioPBBORWMMMSJ9BE1Wg

# Optional local override — widen the window so you can test without waiting
# for Saturday morning. `* * * * *` means "always open".
# LIVE_CHECK_CRON=* * * * *

# /api/contact's first delivery channel: email, via the `send_email` binding.
# `wrangler dev` simulates the binding rather than sending anything — it prints
# the From/To/Subject and writes the body to .wrangler/tmp/email/, so you can
# read exactly what the church would receive without a Cloudflare account.
# Both are Worker secrets in production. In production CONTACT_EMAIL_TO must be
# a *verified destination address* on the account — see CONCERNS.md C-31.
CONTACT_EMAIL_TO=
CONTACT_EMAIL_FROM=

# The fallback channel, used only when email is unconfigured or fails. Also a
# Worker secret in production. Point it at any local server that returns 200 to
# watch what the church's inbox would receive; leave every channel unset and the
# form reports `not-configured` instead of pretending.
CONTACT_WEBHOOK_URL=
