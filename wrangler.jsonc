{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tygerberg-sda-website",
  "main": "src/worker/index.ts",
  "compatibility_date": "2025-01-09",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Without this, an unknown path returns a bare 404 with an empty body —
    // the default is "none", and a 404.html in dist is ignored. GitHub Pages
    // picks 404.html up on its own, so only Cloudflare needs telling.
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    // When the LIVE badge is allowed to cost YouTube API quota, as a 5-field
    // cron expression read as a *window* (minute hour day-of-month month
    // day-of-week). Saturdays 09:00-12:59 SAST. Note cron day-of-week 6 is
    // Saturday (0 = Sunday); writing 7 would mean Sunday. Outside the window
    // no API call is made at all.
    //
    // The church streams 09:00-12:30. The hour field cannot express :30, and
    // erring short would drop the badge during the last half hour of a
    // service; erring long only permits polling, and the badge still appears
    // solely when YouTube reports a live stream. See C-14.
    //
    // Keep the minute field `*`. It controls whether the window is OPEN, not
    // how often YouTube is polled — narrowing it to `*\/5` would make the
    // badge vanish for the four minutes between each mark. Poll rate lives on
    // the client, in useLiveStatus.ts (every 5 minutes).
    "LIVE_CHECK_CRON": "* 9-12 * * 6",
    "LIVE_CHECK_TZ": "Africa/Johannesburg"
  },
  "routes": [
    // Production custom domain (zone already lives in the Cloudflare
    // account) — `wrangler deploy` provisions/attaches this automatically.
    { "pattern": "tygerberg-sda.cloudkid.link", "custom_domain": true }
  ]
}
