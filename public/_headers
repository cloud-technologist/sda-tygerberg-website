# Custom response headers for the Cloudflare Worker's static assets.
# Supported natively by Workers static assets, the same way Pages reads it.
# Copied verbatim into dist/ by Astro; GitHub Pages ignores it.

# Unhashed assets default to `max-age=0`, which pins every Cloudflare image
# variant to a 300s floor and has the transformer re-pulling a multi-MB original
# all day. A week, not a year, because these filenames carry no content hash.
# CONCERNS.md C-24.
/images/hod/*
  Cache-Control: public, max-age=604800

# The fallback copies, which browsers do fetch directly. Spelled out rather than
# left to the rule above: whether `*` spans a `/` is not worth being wrong about.
/images/hod/fallback/*
  Cache-Control: public, max-age=604800
